# ============================================================
# FICHIER EXEMPLE — à copier vers ~/.dbt/profiles.yml
# Remplacez les valeurs entre < > par vos informations
# ============================================================

fintrack_analytics:
  target: dev          # par défaut on travaille en dev
  outputs:

    dev:
      type: snowflake
      account: '<votre_compte>'           # ex : xy12345.eu-west-1
      user: '<votre_utilisateur>'
      password: '<votre_mot_de_passe>'
      role: 'FINTRACK_ROLE'
      database: 'FINTRACK_DB'
      warehouse: 'FINTRACK_WH'
      schema: 'DEV_VOTRENOM'              # schéma personnel pour le dev
      threads: 2

    # Section 8.2 : target de production
    # Utilisation : dbt build --target prod
    prod:
      type: snowflake
      account: '<votre_compte>'
      user: '<utilisateur_technique_prod>'
      password: "{{ env_var('DBT_PROD_PASSWORD') }}"   # jamais en clair
      role: 'FINTRACK_ROLE'
      database: 'FINTRACK_DB'
      warehouse: 'FINTRACK_WH'
      schema: 'MARTS'
      threads: 4
